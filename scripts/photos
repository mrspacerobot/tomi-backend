#!/usr/bin/env python3
"""Plan, generate, review and publish the pinned graph's dish photos."""

import argparse
import base64
import datetime
import fcntl
import hashlib
import html
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request

ROOT = Path(__file__).resolve().parent.parent
MANIFEST = ROOT / "dish-photos/manifest.json"
LOCAL = ROOT / "dish-photos/local"
MODEL = "gpt-image-2.5-sunburst-2026-09-08"
STYLE = (
    "Real editorial food photograph for a warm, playful cooking show. One simply plated dish centered "
    "in a square frame, seen from a slightly elevated three-quarter angle, with soft warm spotlight, "
    "dark plum backdrop and natural texture. Let the plate nearly fill the frame. No props, utensils, "
    "hands, people, text or logos. Use only the listed foods, with no extra garnish, sauces or side dishes."
)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, response, code, message, headers, new_url):
        return None


def request(url, *, data=None, headers=None):
    opener = urllib.request.build_opener(NoRedirect)
    with opener.open(urllib.request.Request(url, data=data, headers=headers or {}), timeout=300) as response:
        return response.read()


def inventory(mode="plan"):
    result = subprocess.run(
        ["cargo", "run", "--locked", "--quiet", "--example", "dish-photo-plan", "--", mode],
        cwd=ROOT, check=True, stdout=subprocess.PIPE, text=True,
    )
    return json.loads(result.stdout) if mode == "plan" else None


def save(records):
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=MANIFEST.parent, delete=False) as output:
        temporary = Path(output.name)
        try:
            json.dump([records[key] for key in sorted(records)], output, ensure_ascii=False, indent=2)
            output.write("\n")
            output.close()
            temporary.chmod(0o644)
            temporary.replace(MANIFEST)
        finally:
            temporary.unlink(missing_ok=True)


def plan(work):
    for category in ("missing", "stale", "orphaned"):
        rows = work[category]
        print(f"{category} ({len(rows)})")
        for row in rows:
            print(f"  {row['recipe'] if isinstance(row, dict) else row}")


def image_prompt(dish):
    source = dish["source"]
    shows = sorted({line["thing"] for line in source["ingredients"]})
    recipe = {key: source[key] for key in ("ingredients", "steps", "yields")}
    title = source["names"]["en"]
    prompt = f"{STYLE}\nDish: {title}\nSource recipe: {json.dumps(recipe, ensure_ascii=False)}"
    if not shows:
        raise ValueError(f"{dish['recipe']} has no ingredient ids to review")
    return prompt, shows


def image_bytes(prompt, key):
    body = json.dumps({
        "model": MODEL, "prompt": prompt, "size": "1024x1024", "output_format": "webp",
        "output_compression": 85,
    }).encode()
    response = request("https://api.openai.com/v1/images/generations", data=body, headers={
        "Authorization": f"Bearer {key}", "Content-Type": "application/json",
    })
    return base64.b64decode(json.loads(response)["data"][0]["b64_json"], validate=True)


def webp_name(data):
    if data[:4] != b"RIFF" or data[8:12] != b"WEBP":
        raise ValueError("expected a WebP image")
    return hashlib.sha256(data).hexdigest() + ".webp"


def generate(work, args):
    pending = work["missing"] + work["stale"]
    selected = [dish for dish in pending if not args.recipe or dish["recipe"] == args.recipe][:args.limit]
    if not selected:
        print("No missing or stale dishes match.")
        return
    key = None if args.from_webp else os.environ.get("OPENAI_API_KEY")
    if not args.from_webp and not key:
        raise ValueError("set OPENAI_API_KEY for the image generator")
    LOCAL.mkdir(parents=True, exist_ok=True)
    for dish in selected:
        prompt, shows = image_prompt(dish)
        if args.from_webp:
            prompt = args.prompt_file.read_text(encoding="utf-8").strip()
            if not prompt:
                raise ValueError("the prompt file is empty")
            data = args.from_webp.read_bytes()
        else:
            data = image_bytes(prompt, key)
        file = webp_name(data)
        (LOCAL / file).write_bytes(data)
        recipe = dish["recipe"]
        work["records"][recipe] = {
            "recipe": recipe, "shows": shows, "recipeFingerprint": dish["recipeFingerprint"],
            "file": file, "model": args.source_model or MODEL, "prompt": prompt, "status": "generated",
        }
        save(work["records"])
        print(f"{recipe}  {file}", flush=True)


def verified_local(record):
    data = (LOCAL / record["file"]).read_bytes()
    if webp_name(data) != record["file"]:
        raise ValueError(f"image hash differs from the manifest for {record['recipe']}")
    return data


def fresh_records(work, status):
    unavailable = {dish["recipe"] for dish in work["stale"]} | set(work["orphaned"])
    return [record for recipe, record in work["records"].items()
            if recipe not in unavailable and record["status"] == status]


def review_page(records):
    cards = []
    for record in records:
        verified_local(record)
        recipe = html.escape(record["recipe"])
        shows = "".join(f"<li>{html.escape(food)}</li>" for food in record["shows"])
        cards.append(f'<article><img src="{record["file"]}" alt=""><h2>{recipe}</h2><ul>{shows}</ul></article>')
    LOCAL.mkdir(parents=True, exist_ok=True)
    page = LOCAL / "review.html"
    page.write_text(
        '<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width">'
        '<title>Dish photo review</title><style>body{font:1rem system-ui;margin:2rem;background:#fff4e5;'
        'color:#291c29}main{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,20rem),1fr));'
        'gap:1.5rem}article{background:white;border-radius:.75rem;padding:1rem;overflow-wrap:anywhere}'
        'img{width:100%;border-radius:.5rem}h2{font-size:1rem}</style><h1>Dish photo review</h1>'
        '<p>Check the plate against the listed foods. Reject uncertain plates or extra foods.</p><main>'
        + "".join(cards) + '</main></html>\n', encoding="utf-8",
    )
    print(page)


def review(work, args):
    records = fresh_records(work, "generated")
    if not args.recipe:
        review_page(records)
        return
    record = next((record for record in records if record["recipe"] == args.recipe), None)
    if not record:
        raise ValueError("the recipe has no fresh generated photo")
    if args.decision == "approve":
        verified_local(record)
        inventory("validate")
        record.update(status="approved", approvedBy=args.reviewer.strip(), approvedOn=datetime.date.today().isoformat())
    else:
        record.update(status="rejected")
    save(work["records"])


def public_object(root, file):
    return f"{root}/storage/v1/object/public/dish-photos/{file}"


def is_uploaded(root, record):
    try:
        data = request(public_object(root, record["file"]))
    except urllib.error.HTTPError as error:
        if error.code in (400, 404):
            return False
        raise
    if webp_name(data) != record["file"]:
        raise ValueError(f"public image hash differs for {record['recipe']}")
    return True


def upload(work, args):
    inventory("validate")
    records = fresh_records(work, "approved")
    if not records:
        print("No fresh approved photos to upload.")
        return
    root = args.project_url.rstrip("/")
    project = urllib.parse.urlsplit(root)
    if (project.scheme != "https" or not project.hostname or project.username is not None
            or project.path or project.query or project.fragment):
        raise ValueError("provide the HTTPS Supabase project origin")
    key = subprocess.check_output(
        ["security", "find-generic-password", "-s", args.keychain_service, "-w"], text=True,
    ).strip()
    headers = {"apikey": key, "Content-Type": "image/webp", "x-upsert": "false", "cache-control": "31536000"}
    if not key.startswith("sb_secret_"):
        headers["Authorization"] = f"Bearer {key}"
    for record in records:
        if not is_uploaded(root, record):
            data = verified_local(record)
            url = f"{root}/storage/v1/object/dish-photos/{record['file']}"
            request(url, data=data, headers=headers)
            if not is_uploaded(root, record):
                raise ValueError(f"uploaded photo is not publicly readable for {record['recipe']}")
        print(public_object(root, record["file"]))


def arguments():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("plan")
    generate_parser = commands.add_parser("generate")
    generate_parser.add_argument("--recipe")
    generate_parser.add_argument("--limit", type=int, default=1)
    generate_parser.add_argument("--from-webp", type=Path)
    generate_parser.add_argument("--source-model")
    generate_parser.add_argument("--prompt-file", type=Path)
    review_parser = commands.add_parser("review")
    decision = review_parser.add_mutually_exclusive_group()
    decision.add_argument("--approve", dest="approval")
    decision.add_argument("--reject", dest="rejection")
    review_parser.add_argument("--reviewer")
    upload_parser = commands.add_parser("upload")
    upload_parser.add_argument("--project-url", required=True)
    upload_parser.add_argument("--keychain-service", default="tomi-dish-photos")
    args = parser.parse_args()
    if args.command == "generate":
        if args.limit < 1:
            parser.error("--limit must be positive")
        if args.from_webp and not (args.recipe and args.source_model and args.prompt_file):
            parser.error("--from-webp requires --recipe, --source-model and --prompt-file")
        if not args.from_webp and (args.source_model or args.prompt_file):
            parser.error("--source-model and --prompt-file are for --from-webp")
    if args.command == "review":
        args.recipe = args.approval or args.rejection
        args.decision = "approve" if args.approval else "reject"
        if args.approval and (not args.reviewer or not args.reviewer.strip()):
            parser.error("--approve requires --reviewer")
    return args


def main():
    args = arguments()
    if args.command == "plan":
        plan(inventory())
        return
    LOCAL.mkdir(parents=True, exist_ok=True)
    with (LOCAL / ".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        work = inventory()
        {"generate": generate, "review": review, "upload": upload}[args.command](work, args)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        sys.exit(str(error))
