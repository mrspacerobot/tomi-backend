# Copy to .env for local runs. Never commit .env.
# Supabase: Connect > Session pooler. Keep the password out of git.
DATABASE_URL=postgres://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Only if the project still signs tokens with the legacy shared secret.
SUPABASE_JWT_SECRET=
MIN_APP_VERSION=1.0.0
# Tomi's library: lessons, ingredient table, equipment and skills.
LIBRARY_DIR=library
# Google AI Studio key. Without it the scan is unavailable and specials
# rank without AI. On the free tier Google may train on what you send.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Supabase secret key (server only, never the app). Without it no photo
# can be kept for the dataset.
SUPABASE_SECRET_KEY=
PHOTO_BUCKET=fridge-photos
RUN_MIGRATIONS=true
RUST_LOG=info
