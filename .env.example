# Copy to .env for local runs. Never commit .env.
# Supabase: Connect > Session pooler. Keep the password out of git.
DATABASE_URL=postgres://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Only if the project still signs tokens with the legacy shared secret.
SUPABASE_JWT_SECRET=
MIN_APP_VERSION=1.0.0
# Tomi's library: lessons, ingredient table, equipment and skills.
LIBRARY_DIR=library
# Google AI Studio key. Without it the scan is unavailable and specials
# rank without AI. On the free tier Google may train on what you send.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Supabase secret key (server only, never the app). Without it scans still
# work, but no photo is kept for the dataset.
SUPABASE_SECRET_KEY=
PHOTO_BUCKET=fridge-photos
# The cooking graph pinned in graph.lock, fetched by scripts/fetch-graph.sh.
GRAPH_DIR=graph
# Only while the graph repository can build nothing but a draft channel.
GRAPH_ALLOW_DRAFT=false
# Set true in a deployment: a build that pins no graph then refuses to start.
GRAPH_REQUIRED=false
RUN_MIGRATIONS=true
RUST_LOG=info
